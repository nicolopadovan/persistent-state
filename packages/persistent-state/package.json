{
  "name": "@nicolopadovan/persistent-state",
  "version": "0.2.1",
  "description": "Persistent React state in a cookie, localStorage or sessionStorage, readable on the server for cookies.",
  "keywords": [
    "react",
    "nextjs",
    "state",
    "persist",
    "cookie",
    "localstorage",
    "sessionstorage",
    "ssr"
  ],
  "type": "module",
  "license": "MIT",
  "author": "nicolopadovan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicolopadovan/persistent-state.git",
    "directory": "packages/persistent-state"
  },
  "homepage": "https://persistent-state.nicolopadovan.com",
  "bugs": "https://github.com/nicolopadovan/persistent-state/issues",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "AGENTS.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "browserslist": [
    "chrome >= 94",
    "edge >= 94",
    "firefox >= 93",
    "safari >= 15.4",
    "ios_saf >= 15.4"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "lint": "eslint src test --max-warnings 0",
    "test": "vitest run --config vitest.config.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:package": "publint && attw --pack . --profile esm-only && size-limit && es-check checkBrowser --module --checkBrowser 'dist/**/*.js' --not dist/next.js"
  },
  "peerDependencies": {
    "next": "^15.0.0 || ^16.0.0",
    "react": "^18.3.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@size-limit/esbuild": "^14.2.0",
    "@size-limit/file": "^14.2.0",
    "@vitest/browser-playwright": "5.0.4",
    "es-check": "^9.8.1",
    "next": "16.4.0",
    "playwright": "^1.64.1",
    "publint": "^0.3.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "size-limit": "^14.2.0",
    "zod": "^4.6.7"
  }
}
